[project]
name = "terra-jupyter-python"
version = "1.2.0"
description = "Python environment for Terra notebooks with scientific computing packages"
readme = "README.md"
requires-python = ">=3.13, <3.14"
dependencies = [
    "biopython>=1.86",
    "bokeh>=3.9.0",
    "bx-python>=0.14.0",
    "certifi>=2026.2.25",
    "fastinterval>=0.1.1",
    "html5lib>=1.1",
    "jupyter-contrib-nbextensions==0.7.0",
    "matplotlib-venn>=1.1.2",
    "mizani>=0.13",
    "nbstripout>=0.8.1",
    "packaging",
    "pdoc3>=0.11.6",
    "plotnine>=0.15",
    "py4j>=0.10.9.9",
    "pyfasta>=0.5.2",
    # pymc3 / theano are abandoned and pin numpy<1.22.2 and scipy<1.8, which have no Python 3.13 builds; pymc replaces both
    "pymc>=5.25",
    "pysam>=0.23.3",
    "pyvcf3>=1.0.4",
    "requests>=2.29.0",
    "seaborn>=0.13.2",
    "tensorflow>=2.21.0",
    "tqdm>=4.67.3",
    "pandas-gbq>=0.34.1",
    "google-cloud-bigquery-datatransfer>=3.22.0",
    # Linux x86_64 only
    "intel-openmp; sys_platform == 'linux' and platform_machine == 'x86_64'",
    "mkl; sys_platform == 'linux' and platform_machine == 'x86_64'",
    "scikit-learn-intelex; sys_platform == 'linux' and platform_machine == 'x86_64'",
    "python-lzo; sys_platform == 'linux' and platform_machine == 'x86_64'",
]

[tool.uv]
required-environments = ["sys_platform == 'linux' and platform_machine == 'x86_64'"]

[build-system]
requires = ["setuptools>=70.3.0", "wheel>=0.45.1"]
build-backend = "setuptools.build_meta"

[tool.setuptools]
packages = []
include-package-data = false
