{
  "name": "terra-jupyterlab-extension",
  "version": "0.1.0",
  "description": "Terra edit mode, playground mode and Terra UI iframe integration for JupyterLab 4 and Notebook 7",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/DataBiosphere/terra-docker",
  "license": "BSD-3-Clause",
  "author": {
    "name": "DSP Analysis Team",
    "email": "dsp-analysis@broadinstitute.org"
  },
  "files": [
    "lib/**/*.{d.ts,js,js.map,json}",
    "style/**/*.{css,js}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "styleModule": "style/index.js",
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DataBiosphere/terra-docker.git"
  },
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "jlpm clean && jlpm build:lib:prod && jlpm build:labextension",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "jlpm clean:lib && jlpm clean:labextension",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf terra_jupyterlab_extension/labextension",
    "eslint": "jlpm eslint:check --fix",
    "eslint:check": "eslint src",
    "lint": "jlpm prettier && jlpm eslint",
    "lint:check": "jlpm prettier:check && jlpm eslint:check",
    "prettier": "prettier --write \"src/**/*.ts\" \"style/**/*.css\" \"*.json\" \"*.mjs\"",
    "prettier:check": "prettier --check \"src/**/*.ts\" \"style/**/*.css\" \"*.json\" \"*.mjs\"",
    "test": "jest",
    "watch": "tsc -w --sourceMap"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.6.6",
    "@jupyterlab/apputils": "^4.7.6",
    "@jupyterlab/coreutils": "^6.6.6",
    "@jupyterlab/docmanager": "^4.6.6",
    "@jupyterlab/mainmenu": "^4.6.6",
    "@jupyterlab/notebook": "^4.6.6",
    "@jupyterlab/services": "^7.6.6",
    "@jupyterlab/ui-components": "^4.6.6",
    "@lumino/widgets": "^2.10.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.3.0",
    "@types/jest": "^29.5.14",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "terra_jupyterlab_extension/labextension"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "endOfLine": "auto"
  }
}
